# Auth (JWT) — obrigatório em produção
AUTH_SECRET=

# Banco de dados (SQLite/libSQL) — usuários, pagamentos e limite de petições
# Local (dev): arquivo ./data/app.db — o diretório é criado automaticamente.
DATABASE_URL=file:./data/app.db
# Turso (prod): troque por libsql://<org>.turso.io e defina o token abaixo.
# DATABASE_AUTH_TOKEN=

# Stripe (pagamento) — o status de acesso é persistido no banco, não no Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Site
NEXT_PUBLIC_SITE_URL=https://recuperajogo.vercel.app

# Resend (leads)
RESEND_API_KEY=
RESEND_FROM=RecuperaJogo <onboarding@resend.dev>
LEADS_NOTIFY_EMAIL=

# Opcional
NEXT_PUBLIC_VIDEO_URL=

# LEGADO (não usado mais — projeto Supabase pausado)
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

# Asaas (Pix)
ASAAS_API_KEY=
ASAAS_BASE_URL=https://api-sandbox.asaas.com/v3
ASAAS_WEBHOOK_TOKEN=
